USE ecommerce_db;
SHOW TABLES;
SELECT * FROM customers;
SELECT * FROM orders;

SELECT * FROM customers
WHERE city = 'Delhi';

SELECT * FROM orders
ORDER BY amount DESC;

SELECT customer_id,
SUM(amount) AS total_sales
FROM orders
GROUP BY customer_id;

SELECT c.name, o.amount
FROM customers c
INNER JOIN Orders o
ON c.customer_id = o.customer_id;

SELECT c.name, o.amount
FROM customers c
LEFT JOIN Orders o
ON c.customer_id = o.customer_id;

SELECT AVG(amount) AS average_order_value
FROM Orders;

SELECT *
FROM Orders
WHERE amount >
(
SELECT AVG(amount)
FROM Orders
);

CREATE VIEW customer_sales AS
SELECT c.name,
SUM(o.amount) AS total_sales
FROM customers c
INNER JOIN Orders o
ON c.customer_id = o.customer_id
GROUP BY c.name;

SELECT * FROM customer_sales;

CREATE INDEX idx_customer
ON orders(customer_id);


